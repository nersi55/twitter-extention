{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "webextensions": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": ["html"],
  "globals": {
    "chrome": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  }
}